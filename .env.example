# Copy to .env — this file IS committed; .env is git-ignored.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hr_payroll

DATABASE_URL=postgresql+asyncpg://hr:hr@postgres:5432/hr_payroll
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120

# PII field-level encryption (DPDP Act 2023) — see shared/hr_shared/crypto.py
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_with_Fernet_generate_key

PT_DEFAULT_STATE=Maharashtra
PF_CEILING_ENABLED=true

# ── MinIO object storage ──────────────────────────────────────────────────────
# Root credentials: used ONLY by the minio container and minio-init provisioner.
# Never injected into application service containers.
MINIO_ROOT_USER=CHANGE_ME_minio_root_user
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# Service account: least-privilege IAM user created by scripts/init-minio.sh.
# These are the credentials the blobstore-service uses at runtime.
# MINIO_SERVICE_ACCESS_KEY becomes the IAM username (access key ID).
# MINIO_SERVICE_SECRET_KEY must be at least 8 characters.
MINIO_SERVICE_ACCESS_KEY=blobstore-svc
MINIO_SERVICE_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# Browser-reachable host:port (NO scheme) embedded in presigned upload/download
# URLs. Defaults to localhost:9000 for local dev; MUST be overridden for any
# non-local deployment (e.g. s3.example.com or s3.example.com:443) or
# presigned URLs returned to browsers will be unreachable off this host.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# For seed.py running on the host (talks to the gateway):
GATEWAY_URL=http://localhost:4000

# ── First-run admin account (optional) ────────────────────────────────────────
# When both EMAIL and PASSWORD are set, auth-service creates this tenant + admin
# on startup if it doesn't already exist, so a fresh deployment is immediately
# loggable-into without running scripts/seed.py. Idempotent: existing accounts
# are left untouched, and changing the password here does NOT reset it (use the
# app, or delete the user, to rotate it).
# Leave blank to disable and register the first tenant through the UI instead.
# The admin gets ORG_ADMIN + HR_MANAGER + PAYROLL_ADMIN. Minimum 8 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TENANT=Default Organization

# Public tenant signup via POST /api/v1/auth/register.
# false (default): the first registration on an empty instance is allowed so a
#   fresh deployment can bootstrap, and every later one is refused with 403.
#   This is what you want for a single-company deployment.
# true: anyone who can reach the URL can create their own tenant (SaaS mode).
ALLOW_PUBLIC_REGISTRATION=false
