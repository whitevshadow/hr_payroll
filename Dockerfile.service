# Generic Dockerfile for every Python/FastAPI service.
# Build context is the repo root. Pass SERVICE (folder under services/) and PORT.
FROM python:3.11-slim

ARG SERVICE
ARG PORT=4000

# PIP_* settings: `docker compose build` builds every service at once, so a
# deploy opens a dozen concurrent PyPI download streams. pip's defaults (5
# retries, 15s timeout) give up easily under that load and fail the whole
# deployment on a transient read timeout. Coolify rebuilds with --no-cache, so
# there is no layer cache to fall back on and every deploy re-runs these.
#
# Keep every comment ABOVE this instruction, never inside the line
# continuation. Deploy platforms (Coolify among them) rewrite this file with
# line-based parsers to inject ARG and --mount=type=secret directives, and a
# comment between continued lines is what those parsers trip over.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SERVICE=${SERVICE} \
    PORT=${PORT} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install PDF dependencies only for reporting-service
RUN if [ "$SERVICE" = "reporting-service" ]; then \
      export DEBIAN_FRONTEND=noninteractive && \
      apt-get update && \
      apt-get install -y --no-install-recommends \
        libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 shared-mime-info && \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Install the shared package first (cached unless shared changes).
COPY shared/ /app/shared/
RUN pip install --no-cache-dir -e /app/shared

# Install the service's own requirements.
COPY services/${SERVICE}/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the service code.
COPY services/${SERVICE}/app /app/app

EXPOSE ${PORT}
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
