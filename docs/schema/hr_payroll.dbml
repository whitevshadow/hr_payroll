// ═══════════════════════════════════════════════════════════════════════════
//  HR Payroll — database schema (DBML)
//  Paste into https://dbdiagram.io to render the ER diagram.
//
//  Generated from the LIVE database (information_schema), not from the ORM
//  models, so it reflects what is actually deployed. Where the two disagree,
//  the drift is called out under "SCHEMA DRIFT" at the bottom of this file.
//
//  ── How to read this ──────────────────────────────────────────────────────
//
//  1. PRIMARY KEYS
//     Every table has the same primary key: a single `id uuid`, generated
//     application-side by SQLAlchemy (hr_shared.TenantAwareBase), not by a
//     database default. There are no composite primary keys and no sequences
//     anywhere in the schema. Business uniqueness is expressed separately as
//     UNIQUE indexes (see each table's `indexes` block).
//
//  2. TENANCY
//     Almost every table carries `tenant_id uuid NOT NULL`. It is the
//     multi-tenant isolation key and is part of most UNIQUE constraints, but
//     it is NOT a foreign key to auth_schema.tenants — see point 3.
//
//  3. WHY THERE ARE SO FEW FOREIGN KEYS  ← the important part
//     This is a microservice deployment: one Postgres database, one schema
//     per service, and each service owns its schema exclusively. Foreign keys
//     are therefore only declared WITHIN a schema (15 of them, listed below).
//
//     Every reference that CROSSES a service boundary — and that is most of
//     the interesting ones, e.g. payroll_results.employee_id pointing at
//     employee_schema.employees.id — is an unenforced UUID column. The
//     database will not stop you deleting an employee who has payslips, and
//     no cascade will clean up after you. Those relationships are documented
//     below as `Ref` lines under "LOGICAL REFERENCES" and are drawn on the
//     diagram, but they do NOT exist as constraints in the database.
//
//     Practical consequence: deleting an employee orphans their payroll
//     results, attendance, and statutory contributions in the other schemas.
//     The application deletes them explicitly or leaves them behind.
// ═══════════════════════════════════════════════════════════════════════════

Project hr_payroll {
  database_type: 'PostgreSQL'
  Note: 'Multi-tenant HR & payroll platform. One schema per microservice; cross-service references are unenforced UUIDs.'
}

// ═══════════════ attendance_schema ═══════════════

Table attendance_schema.attendance_audit {
  actor_id uuid [not null]
  employee_id uuid
  month date
  event_type varchar(60) [not null]
  previous_value text
  new_value text
  reason text
  created_at timestamptz [not null, default: '2026-06-15 14:21:46.146496+00']
  id uuid [pk]
  tenant_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]
}

Table attendance_schema.attendance_months {
  month date [not null]
  status varchar(20) [not null]
  total_employees integer [not null]
  employees_with_lop integer [not null]
  completion_pct decimal(5,2) [not null]
  validated_by uuid
  validated_at timestamptz
  locked_by uuid
  locked_at timestamptz
  locked_reason text
  unlocked_by uuid
  unlocked_at timestamptz
  unlock_reason text
  id uuid [pk]
  tenant_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  client_id uuid

  indexes {
    (tenant_id,client_id,month) [unique]
  }
}

Table attendance_schema.attendance_records {
  employee_id uuid [not null]
  month date [not null]
  total_days integer [not null]
  present_days decimal(5,1) [not null]
  lop_days decimal(5,1) [not null]
  payable_days decimal(5,1) [not null]
  is_finalized boolean [not null]
  cl_days decimal(5,1) [not null]
  sl_days decimal(5,1) [not null]
  pl_days decimal(5,1) [not null]
  wo_days decimal(5,1) [not null]
  holiday_days decimal(5,1) [not null]
  wfh_days decimal(5,1) [not null]
  overtime_hours decimal(6,1) [not null]
  attendance_pct decimal(5,2) [not null]
  daily_status text
  id uuid [pk]
  tenant_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  leave_breakdown jsonb
  client_id uuid

  indexes {
    (tenant_id,employee_id,month) [unique]
  }
}

Table attendance_schema.leave_balances {
  employee_id uuid [not null]
  leave_type varchar(30) [not null]
  financial_year varchar(9) [not null]
  opening_balance decimal(5,1) [not null]
  accrued decimal(5,1) [not null]
  used decimal(5,1) [not null]
  carry_forward_used decimal(5,1) [not null]
  closing_balance decimal(5,1) [not null]
  id uuid [pk]
  tenant_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id,employee_id,leave_type,financial_year) [unique]
  }
}

Table attendance_schema.leave_policies {
  client_id uuid
  name varchar(150) [not null]
  leave_type varchar(30) [not null]
  annual_allowance decimal(5,1) [not null]
  carry_forward boolean [not null]
  max_carry_forward decimal(5,1) [not null]
  encashable boolean [not null]
  max_consecutive_days integer [not null]
  accrual_type varchar(20) [not null]
  is_active boolean [not null]
  id uuid [pk]
  tenant_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  description text
  requires_document_after_days integer
}

Table attendance_schema.leave_requests {
  employee_id uuid [not null]
  leave_type varchar(30) [not null]
  from_date date [not null]
  to_date date [not null]
  days decimal(5,1) [not null]
  reason text
  status varchar(20) [not null]
  applied_by uuid [not null]
  reviewed_by uuid
  reviewed_at timestamptz
  review_comment text
  financial_year varchar(9)
  id uuid [pk]
  tenant_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table attendance_schema.leave_transactions {
  employee_id uuid [not null]
  leave_request_id uuid
  leave_type varchar(30) [not null]
  financial_year varchar(9) [not null]
  transaction_type varchar(30) [not null]
  days decimal(5,1) [not null]
  balance_after decimal(5,1)
  "note" text
  created_at timestamptz [not null, default: '2026-07-08 06:47:51.158469+00']
  id uuid [pk]
  tenant_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]
}

// ═══════════════ audit_schema ═══════════════

Table audit_schema.audit_logs {
  id uuid [pk]
