}


// ══════ Enforced foreign keys (all are WITHIN one schema) ══════
Ref: auth_schema.roles.user_id > auth_schema.users.id [delete: cascade]
Ref: employee_schema.client_documents.client_id > employee_schema.clients.id [delete: cascade]
Ref: employee_schema.client_portal_credentials.client_id > employee_schema.clients.id [delete: cascade]
Ref: employee_schema.departments.client_id > employee_schema.clients.id [delete: no action]
Ref: employee_schema.departments.parent_department_id > employee_schema.departments.id [delete: set null]
Ref: employee_schema.employees.daily_rate_card_id > employee_schema.daily_rate_cards.id [delete: set null]
Ref: employee_schema.employees.department_id > employee_schema.departments.id [delete: no action]
Ref: employee_schema.employees.location_id > employee_schema.locations.id [delete: no action]
Ref: employee_schema.employees.reporting_manager_id > employee_schema.employees.id [delete: set null]
Ref: employee_schema.locations.client_id > employee_schema.clients.id [delete: no action]
Ref: employee_schema.workflow_instances.definition_id > employee_schema.workflow_definitions.id [delete: no action]
Ref: employee_schema.workflow_step_actions.instance_id > employee_schema.workflow_instances.id [delete: cascade]
Ref: payout_schema.payout_transactions.batch_id > payout_schema.payout_batches.id [delete: cascade]
Ref: payroll_schema.payroll_results.cycle_id > payroll_schema.payroll_cycles.id [delete: cascade]
Ref: salary_schema.salary_components.structure_id > salary_schema.salary_structures.id [delete: cascade]


// ═══════════════════════════════════════════════════════════════════════════
//  LOGICAL REFERENCES — cross-service, NOT enforced by the database
//
//  Each line below is a real relationship the application relies on, stored
//  as a bare uuid with no FK because the two tables belong to different
//  services. dbdiagram will draw them; Postgres will not enforce them.
// ═══════════════════════════════════════════════════════════════════════════

// ── Everything is scoped to a tenant (auth-service owns the tenant list) ──
Ref: employee_schema.clients.tenant_id > auth_schema.tenants.id
Ref: auth_schema.users.tenant_id > auth_schema.tenants.id

// ── An employee's identity is owned by employee-service; every other
//    service references it by id only ──
Ref: salary_schema.salary_structures.employee_id > employee_schema.employees.id
Ref: attendance_schema.attendance_records.employee_id > employee_schema.employees.id
Ref: attendance_schema.leave_requests.employee_id > employee_schema.employees.id
Ref: attendance_schema.leave_balances.employee_id > employee_schema.employees.id
Ref: attendance_schema.leave_transactions.employee_id > employee_schema.employees.id
Ref: attendance_schema.attendance_audit.employee_id > employee_schema.employees.id
Ref: payroll_schema.payroll_results.employee_id > employee_schema.employees.id
Ref: compliance_schema.pf_contributions.employee_id > employee_schema.employees.id
Ref: compliance_schema.esi_contributions.employee_id > employee_schema.employees.id
Ref: compliance_schema.pt_deductions.employee_id > employee_schema.employees.id
Ref: compliance_schema.lwf_contributions.employee_id > employee_schema.employees.id
Ref: compliance_schema.bonus_records.employee_id > employee_schema.employees.id
Ref: compliance_schema.gratuity_records.employee_id > employee_schema.employees.id
Ref: payout_schema.payout_transactions.employee_id > employee_schema.employees.id
Ref: reporting_schema.generated_reports.employee_id > employee_schema.employees.id

// ── A payroll cycle is owned by payroll-service; downstream services key
//    their per-run output off it ──
Ref: compliance_schema.pf_contributions.cycle_id > payroll_schema.payroll_cycles.id
Ref: compliance_schema.esi_contributions.cycle_id > payroll_schema.payroll_cycles.id
Ref: compliance_schema.pt_deductions.cycle_id > payroll_schema.payroll_cycles.id
Ref: compliance_schema.lwf_contributions.cycle_id > payroll_schema.payroll_cycles.id
Ref: payout_schema.payout_batches.cycle_id > payroll_schema.payroll_cycles.id
Ref: reporting_schema.generated_reports.cycle_id > payroll_schema.payroll_cycles.id

// ── Client scoping. clients lives in employee_schema, so references from
//    other services are unenforced ──
Ref: payroll_schema.payroll_cycles.client_id > employee_schema.clients.id
Ref: attendance_schema.attendance_months.client_id > employee_schema.clients.id
Ref: attendance_schema.attendance_records.client_id > employee_schema.clients.id
Ref: attendance_schema.leave_policies.client_id > employee_schema.clients.id
Ref: compliance_schema.compliance_settings.client_id > employee_schema.clients.id
Ref: salary_schema.salary_templates.client_id > employee_schema.clients.id

// ── Leave (feature currently unrouted in the UI) ──
//   NOTE: leave_requests and leave_balances do NOT hold a policy id. They
//   carry a `leave_type` string (CASUAL / SICK / EARNED / ...) that is matched
//   against leave_policies.leave_type for the same client. It is a lookup by
//   value, not a key relationship, so no Ref is drawn — a request can name a
//   leave_type that has no policy row behind it.

// ── Blobs live in MinIO; these columns hold the object id, not a row id ──
// employee_schema.client_documents.blob_id   -> MinIO object
// reporting_schema.generated_reports.file_path -> MinIO object (payslip PDF)


// ═══════════════════════════════════════════════════════════════════════════
//  KEY BUSINESS RULES ENCODED AS UNIQUE CONSTRAINTS
// ═══════════════════════════════════════════════════════════════════════════
//  employees            (tenant_id, emp_code)              one code per tenant *
//  clients              (tenant_id, client_code)
//  daily_rate_cards     (tenant_id, client_id, name)
//  salary_structures    (tenant_id, employee_id, effective_from)
//                       -> salary history is append-only; a revision is a new row
//  attendance_records   (tenant_id, employee_id, month)     one row per person-month
//  attendance_months    (tenant_id, client_id, month)       the lock/validate control row
//  leave_balances       (tenant_id, employee_id, leave_type, financial_year)
//  payroll_results      (tenant_id, cycle_id, employee_id)  makes a re-run idempotent
//  compliance_settings  (tenant_id, client_id, state)       PF/ESI/PT/LWF switches per state
//  payout_transactions  (idempotency_key)                   stops a double payout
//  users                (tenant_id, email)
//  financial_years      (tenant_id, name)
//  client_portal_credentials (client_id, portal_type)
//
//  * see SCHEMA DRIFT below — the model intends (tenant_id, client_id, emp_code)


// ═══════════════════════════════════════════════════════════════════════════
//  SCHEMA DRIFT — live database vs SQLAlchemy models
//
//  Tables are created with metadata.create_all() at service startup. That
//  creates MISSING tables but never ALTERs an existing one, so constraints
//  added to a model after a table already exists are silently absent in a
//  long-lived database. Two such gaps are present here:
//
//  1. employee_schema.employees
//       model : UNIQUE (tenant_id, client_id, emp_code)
//       live  : UNIQUE (tenant_id, emp_code)
//     Effect: two clients under one tenant cannot both use "E001". The model
//     was changed to allow it; the deployed database still forbids it.
//
//  2. compliance_schema.{pf,esi,pt,lwf}_contributions
//       model : UNIQUE (tenant_id, employee_id, cycle_id)
//       live  : no unique constraint at all
//     Effect: nothing stops duplicate contribution rows for one employee in
//     one cycle, which would double-count statutory totals. The delete-then-
//     insert in /compliance/compute is currently the only thing preventing it.
//
//  Both need an explicit migration; create_all will not fix them.
//
//  ── Orphaned objects (exist in the database, unused by any running code) ──
//  ── Frozen created_at defaults (data bug, not a modelling one) ──
//  attendance_schema.attendance_audit.created_at
//  attendance_schema.leave_transactions.created_at
//      Default is a FROZEN literal timestamp, not now():
//        attendance_audit    DEFAULT '2026-06-15 14:21:46.146496+00'
//        leave_transactions  DEFAULT '2026-07-08 06:47:51.158469+00'
//      These came from ALTER TABLE ... ADD COLUMN with an evaluated default,
//      so every row inserted since gets that same fixed timestamp instead of
//      its real insertion time. All 26 attendance_audit rows currently share
//      one created_at value, which makes the audit trail useless for ordering
//      or for answering "when did this change?". Compare
//      attendance_records.created_at, which correctly defaults to now().
//      Fix: ALTER TABLE ... ALTER COLUMN created_at SET DEFAULT now();
//
//  compliance_schema.esi_eligibility_periods
//      Superseded — ESI contribution-period eligibility is now derived by
//      querying esi_contributions.wage_month. The model was deleted; the
//      table was not dropped.
//  tds_schema.* (13 tables)
//      tds-service is disconnected from the platform: no container, not in
//      docker-compose, no gateway route. The schema was dropped once and
//      recreated by a stale container's create_all. Excluded from this file.
// ═══════════════════════════════════════════════════════════════════════════
